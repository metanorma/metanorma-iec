<section class="title-section iec-title-section" aria-label="IEC publication">
  {% if publisher_logos %}
  <div class="cover-publishers">
    {% for logo in publisher_logos %}{{ logo }}{% endfor %}
  </div>
  {% endif %}
  <div class="iec-cover-identity">
    {% if cover.tc_docnumber.size > 0 %}
      {% for num in cover.tc_docnumber %}
    <p class="cover-doc-id">{{ num | escape }}</p>
      {% endfor %}
    {% elsif cover.docnumber_undated %}
    <p class="cover-doc-id">{{ cover.docnumber_undated | escape }}{% if cover.draftinfo %} {{ cover.draftinfo | escape }}{% endif %}</p>
    {% elsif doc_id %}
    <p class="cover-doc-id">{{ doc_id | escape }}</p>
    {% endif %}
    {% if cover.edition_display %}
    <p class="cover-doc-id">{{ cover.edition_display | escape }}</p>
    {% endif %}
    {% if cover.revdate %}
    <p class="cover-date">Date: {{ cover.revdate | escape }}</p>
    {% endif %}
    {% if cover.tc_docnumber.size > 0 and cover.docnumber_undated %}
    <p class="cover-doc-id">{{ cover.docnumber_undated | escape }}{% if cover.draftinfo %} {{ cover.draftinfo | escape }}{% endif %}</p>
    {% endif %}
    {% if cover.editorialgroup %}
    <p class="cover-committee">{{ cover.editorialgroup | escape }}</p>
    {% endif %}
    {% if cover.secretariat %}
    <p class="cover-secretariat">Secretariat: {{ cover.secretariat | escape }}</p>
    {% endif %}
  </div>
  {% if title %}
  <div class="cover-title" lang="en"><span>{{ title | escape }}</span></div>
  {% endif %}
  {% if title_fr %}
  <div class="cover-title-fr" lang="fr"><span>{{ title_fr | escape }}</span></div>
  {% endif %}
  {% if stage %}
  <div class="cover-stage"><p>{{ stage | escape }}</p></div>
  {% endif %}
  {% if cover.ics %}
  <p class="cover-ics"><strong>ICS:</strong> {{ cover.ics | escape }}</p>
  {% endif %}
  {% if doctype %}
  <p class="cover-doctype">{{ doctype | escape }}</p>
  {% endif %}
  {% if cover.ext.subdoctype %}
  <p class="cover-docsubtype">Document subtype: {{ cover.ext.subdoctype | capitalize | escape }}</p>
  {% endif %}
</section>
<hr class="cover-separator" />
